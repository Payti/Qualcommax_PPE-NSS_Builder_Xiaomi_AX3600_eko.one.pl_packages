#
# Build config for the Xiaomi AX3600 (IPQ8071A) — ppe-nss / ppe-nss-mesh images.
# Built from JuliusBairaktaris/openwrt-ppe-nss (branch: ppe-nss) combined with
# JuliusBairaktaris/nss-packages (branch: edma-nss).
#

## Target Platform
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_xiaomi_ax3600=y

## Memory Profile (512 MB RAM)
CONFIG_IPQ_MEM_PROFILE_512=y
CONFIG_KERNEL_IPQ_MEM_PROFILE=512

## PPE-NSS & Wi-Fi (ath11k) Hardware Offload
CONFIG_PACKAGE_kmod-qca-ppe-nss=y
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
CONFIG_PACKAGE_kmod-qca-nss-drv-bridge-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vlan-mgr=y
CONFIG_PACKAGE_kmod-nss-wifi-drv=y
CONFIG_PACKAGE_nss-firmware-ipq8074=y
CONFIG_NSS_FIRMWARE_VERSION_12_5=y
# CONFIG_NSS_FIRMWARE_VERSION_11_4 is not set
CONFIG_ATH11K_NSS_SUPPORT=y
# CONFIG_ATH11K_NSS_MESH_SUPPORT is not set
# CONFIG_ATH11K_DEBUGFS_HTT_STATS is not set

## Compiler and Toolchain Optimization
CONFIG_DEVEL=y
CONFIG_TOOLCHAINOPTS=y
CONFIG_TARGET_OPTIONS=y
CONFIG_BINUTILS_USE_VERSION_2_46=y
CONFIG_GCC_USE_VERSION_15=y
CONFIG_TARGET_OPTIMIZATION="-O2 -pipe -mcpu=cortex-a53"
CONFIG_USE_GC_SECTIONS=y
CONFIG_USE_LTO=y
CONFIG_USE_MOLD=y
# CONFIG_USE_MKLIBS is not set
CONFIG_ZLIB_OPTIMIZE_SPEED=y
# CONFIG_CCACHE is not set

## Kernel & Build Options
CONFIG_BUILD_PATENTED=y
CONFIG_EXPERIMENTAL=y
# CONFIG_ALL_KMODS is not set
# CONFIG_ALL_NONSHARED is not set

## Hardening build options
CONFIG_GCC_DEFAULT_PIE=y
CONFIG_GCC_DEFAULT_SSP=y
CONFIG_PKG_CHECK_FORMAT_SECURITY=y
CONFIG_PKG_ASLR_PIE_ALL=y
CONFIG_PKG_CC_STACKPROTECTOR_ALL=y
CONFIG_KERNEL_CC_STACKPROTECTOR_STRONG=y
CONFIG_PKG_FORTIFY_SOURCE_3=y
CONFIG_PKG_RELRO_FULL=y
CONFIG_USE_SECCOMP=y

## Kernel Diagnostics, Multicast & Crash Forensics
CONFIG_KERNEL_IP_MROUTE=y
CONFIG_KERNEL_IPV6_MROUTE=y
CONFIG_KERNEL_DCB=y
CONFIG_KERNEL_DEVMEM=y
CONFIG_BUSYBOX_CUSTOM=y
